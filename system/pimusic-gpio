#!/usr/bin/env python3
"""PiMusic physical provisioning button and status LEDs."""

import json
import logging
import subprocess
import time

from gpiozero import Button, LED


HOTSPOT_CONTROL = "/usr/local/bin/pimusic-hotspot-control"
BUTTON_HOLD_SECONDS = 3.0
# The helper uses sudo and starts short-lived system commands. Polling it too
# often wastes CPU and fills the audit log on a Pi Zero. Button actions update
# the displayed state immediately; regular state changes can wait briefly.
STATE_REFRESH_SECONDS = 10.0

READY_LED_PIN = 22
SETUP_LED_PIN = 27
PROVISIONING_BUTTON_PIN = 17


logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
logger = logging.getLogger("pimusic-gpio")


def setup_status():
    """Read the shared provisioning state without exposing root access."""
    try:
        result = subprocess.run(
            ["sudo", "-n", HOTSPOT_CONTROL, "status"], check=True,
            capture_output=True, text=True, timeout=10,
        )
        return json.loads(result.stdout).get("state", "UNAVAILABLE")
    except (OSError, subprocess.SubprocessError, ValueError) as error:
        logger.warning("Unable to read provisioning state: %s", error)
        return "UNAVAILABLE"


def start_setup_mode():
    """Enter provisioning through the same constrained helper as the web UI."""
    try:
        subprocess.run(
            ["sudo", "-n", HOTSPOT_CONTROL, "start"], check=True,
            capture_output=True, text=True, timeout=20,
        )
        logger.info("Provisioning requested from GPIO button")
        return True
    except (OSError, subprocess.SubprocessError) as error:
        logger.error("Unable to start provisioning: %s", error)
        return False


def set_leds(ready, setup, state):
    """Render the documented provisioning state without background threads."""
    phase = time.monotonic()
    slow_blink = int(phase * 2) % 2 == 0
    fast_blink = int(phase * 8) % 2 == 0

    if state == "READY":
        ready.on()
        setup.off()
    elif state == "PROVISIONING":
        ready.off()
        setup.value = slow_blink
    elif state == "CONNECTING_WIFI":
        ready.off()
        setup.value = fast_blink
    elif state == "TRYING_WIFI":
        ready.value = slow_blink
        setup.off()
    else:
        ready.value = fast_blink
        setup.off()


def main():
    ready = LED(READY_LED_PIN)
    setup = LED(SETUP_LED_PIN)
    button = Button(PROVISIONING_BUTTON_PIN, pull_up=True, bounce_time=0.05)
    button_pressed_at = None
    setup_requested_for_press = False
    state = "UNAVAILABLE"
    next_state_refresh = 0.0

    logger.info("GPIO controls started; hold the provisioning button for %.0f seconds", BUTTON_HOLD_SECONDS)
    try:
        while True:
            now = time.monotonic()
            if now >= next_state_refresh:
                state = setup_status()
                next_state_refresh = now + STATE_REFRESH_SECONDS

            if button.is_pressed:
                if button_pressed_at is None:
                    button_pressed_at = now
                    setup_requested_for_press = False
                    logger.info("Provisioning button pressed")
                elif not setup_requested_for_press and now - button_pressed_at >= BUTTON_HOLD_SECONDS:
                    setup_requested_for_press = True
                    if state == "PROVISIONING":
                        logger.info("Provisioning is already active")
                    elif start_setup_mode():
                        # Make the physical feedback immediate while the
                        # hotspot activation catches up in NetworkManager.
                        state = "PROVISIONING"
                        next_state_refresh = now + STATE_REFRESH_SECONDS
            elif button_pressed_at is not None:
                logger.info("Provisioning button released after %.1f seconds", now - button_pressed_at)
                button_pressed_at = None

            set_leds(ready, setup, state)
            time.sleep(0.05)
    finally:
        ready.off()
        setup.off()
        button.close()
        ready.close()
        setup.close()


if __name__ == "__main__":
    main()
